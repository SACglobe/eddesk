 landscape. We prioritize academic integrity, fiscal responsibility, and the long-term stewardship of our historic campus."},boardMembers:[{name:"Sir Richard Vane",role:"Chairman",image:"school/image/teacher1.png",description:"Former Director of Global Education Initiatives at the UN and lifelong advocate for interdisciplinary studies."},{name:"Lady Eleanor Rose",role:"Vice-Chair",image:"school/image/teacher2.png",description:"Pioneer in child psychology and curriculum development with over 30 years of experience in elite academies."},{name:"Professor Alistair Thorne",role:"Treasurer",image:"school/image/teacher3.png",description:"Emeritus Professor of Economics and fellow of the Royal Society of Arts."},{name:"Dr. Sofia Moretti",role:"Academic Governor",image:"school/image/teacher1.png",description:"Expert in comparative literature and former Dean of International Admissions."}],studentAchievements:[{title:"National Debate Champions",year:"2023",description:"Our senior varsity team secured first place in the National Invitational, demonstrating superior rhetoric and logic."},{title:"Rhodes Scholar Alumnus",year:"2023",description:"Former student Marcus Chen was awarded the prestigious scholarship for postgraduate study at Oxford."},{title:"Global STEM Innovation",year:"2022",description:"Grade 11 robotics collective won the International AI Design challenge in Singapore for their carbon-capture drone system."},{title:"Visual Arts Grand Prize",year:"2022",description:"The annual 'Young Visionary' award was presented to our senior art scholar for her multimedia installation on urban ecology."},{title:"Mathematics Olympiad Gold",year:"2021",description:"Two of our junior students achieved perfect scores in the Continental Mathematical Olympiad."}],stats:[{label:"University Placement",value:"100%",target:100,suffix:"%"},{label:"Student Nationalities",value:"32",target:32,suffix:""},{label:"Faculty PhDs",value:"18",target:18,suffix:""},{label:"Annual Research Projects",value:"65+",target:65,suffix:"+"},{label:"Scholarship Endowment",value:"£4.2M",target:4.2,suffix:"M"}],highlights:[{title:"Innovation Pavilion",image:"school/image/campus1.png",tag:"Campus"},{title:"The Great Library",image:"school/image/campus2.png",tag:"Legacy"},{title:"Olympic Aquatics Center",image:"school/image/campus3.png",tag:"Sports"},{title:"Rooftop Observatory",image:"school/image/campus4.png",tag:"Science"}],activities:{academic:[{title:"Advanced Research",image:"school/image/campus1.png",description:"Post-graduate level research projects in partnership with local universities."},{title:"Quantum Physics Lab",image:"school/image/campus2.png",description:"Hands-on exploration of particle physics and advanced mathematics."}],clubs:[{title:"Robotics & AI",image:"school/image/campus3.png",description:"Designing and programming the autonomous systems of tomorrow."},{title:"Investments & Finance",image:"school/image/campus4.png",description:"Managing a mock endowment fund and learning real-world market dynamics."}],sports:[{title:"Equestrian Club",image:"school/image/campus1.png",description:"Discipline, poise, and partnership with nature at our satellite stables."},{title:"Fencing Mastery",image:"school/image/campus2.png",description:"Refining the tactical mind and physical agility through classical fencing."}],extraCurricular:[{title:"Diplomatic Corps",image:"school/image/campus3.png",description:"Model United Nations and international debate circuits across Europe."},{title:"Wilderness Survival",image:"school/image/campus4.png",description:"Leadership and resilience training in the Scottish Highlands."}],arts:[{title:"Symphony Orchestra",image:"school/image/campus1.png",description:"Classical training and modern composition under renowned conductors."},{title:"Operatic Society",image:"school/image/campus2.png",description:"Performance art at its highest level, integrating drama and vocal mastery."}],leadership:[{title:"Prefect Council",image:"school/image/campus3.png",description:"Empowering the senior student body with institutional governance roles."},{title:"Global Ambassadors",image:"school/image/campus4.png",description:"Representing the Academy at international educational summits."}]},broadcast:[{type:"announcement",date:"2023-11-20",title:"Winter Gala RSVP",content:"Join us for our annual fundraising gala at the Grand Hall. Limited black-tie invitations available for alumni and current families."},{type:"calendar",date:"2023-12-15",title:"Term End Break",content:"School closes for the winter holidays. All boarding houses will transition to vacation protocols by 18:00."},{type:"announcement",date:"2024-01-10",title:"New Science Wing Inauguration",content:"We are proud to welcome Nobel Laureate Dr. Sarah Jenkins for the ribbon-cutting of our Biotech labs."},{type:"calendar",date:"2024-02-14",title:"Mid-Term Symposium",content:"A week-long series of lectures and workshops across all academic departments."}],gallery:[{url:"school/image/campus1.png",caption:"The historic Quadrangle during the annual Founders Day processional.",description:"Our historic grounds serve as a daily reminder of the generations of excellence that have passed through these halls. Founders Day is our most sacred tradition."},{url:"school/image/campus2.png",caption:"Modernist architecture housing our state-of-the-art Science and Research Wing.",description:"Equipped with industry-leading technology, the Science Wing is where our students conduct original research in biotechnology and advanced physics."},{url:"school/image/campus3.png",caption:"Quiet contemplation within the sanctuary of the Great Library.",description:"With over 50,000 volumes, the Great Library is the intellectual heart of the campus, offering a silent space for deep study."},{url:"school/image/campus4.png",caption:"Engaged seminars where critical inquiry meets collaborative mastery.",description:"Our small class sizes facilitate intense discussion, ensuring that every student's voice is heard."}],testimonials:[{name:"Alexandra Hamilton",role:"Class of 2022, Yale University",text:"Sterling didn't just teach me what to think; it taught me how to question. The atmosphere of intellectual rigor and cultural sophistication prepared me for the world in a way I never thought possible."},{name:"Julian de Marco",role:"Parent of Year 11 Student",text:"The institutional integrity and the individual attention our son receives is unparalleled. It's not just a school; it's a sanctuary for potential."},{name:"Dr. Elena Vance",role:"Faculty Member, Physics",text:"As a scientist, I find the facilities here rival top universities. But it is the hunger for knowledge in the eyes of my students that truly sets this institution apart."}],contact:{address:"77 Sterling Heights, Academic District, London SW1",email:"admissions@sterling.edu",phone:"+44 (0) 20 7946 0123",hours:"Mon - Fri: 08:00 - 17:00"},academics:{curriculum:"The International Baccalaureate (IB) Diploma",levels:[{title:"The Foundation (Ages 3-10)",description:"Focusing on inquiry-based learning and the development of core literacies in a nurturing, creatively stimulating environment."},{title:"The Middle Years (Ages 11-15)",description:"Broadening horizons through interdisciplinary study, digital citizenship, and global community service."},{title:"The Diploma Years (Ages 16-18)",description:"Advanced academic specialization, critical epistemology, and independent research preparation for Ivy League entry."}]},infrastructure:[{name:"The Great Library",description:"A sanctuary for thought with over 50,000 physical volumes and digital access to global research databases.",image:"https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&q=80&w=1200"},{name:"Innovation Pavilion",description:"State-of-the-art laboratories for robotics, AI research, and advanced materials science.",image:"https://images.unsplash.com/photo-1541339907198-e08759dfc3ef?auto=format&fit=crop&q=80&w=1200"},{name:"The Performing Arts Hall",description:"A 500-seat acoustic masterpiece designed for symphonic performances and dramatic theatre.",image:"https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?auto=format&fit=crop&q=80&w=1200"}],events:[{id:"1",date:"Nov 15, 2023",category:"Academic",title:"Autumn Research Symposium",description:"Our senior students present their independent research findings to faculty and invited guests."},{id:"2",date:"Dec 05, 2023",category:"Arts",title:"Winter Symphony Performance",description:"An evening of classical and contemporary music featuring the Academy Orchestra."}],blog:[{id:"1",date:"Oct 20, 2023",author:"Dr. Julian Sterling",title:"The Art of Critical Inquiry",excerpt:"Exploring how we cultivate the leaders of tomorrow through the discipline of deep thought.",image:"https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&q=80&w=800"}]};e.s(["schoolData",0,n],35854);let s=()=>{let e=[...n.broadcast,...n.broadcast];return(0,t.jsx)("div",{className:"w-full flex justify-center py-0 animate-in fade-in duration-1000 slide-in-from-top-4",children:(0,t.jsxs)("div",{className:"w-[92%] max-w-7xl h-[48px] bg-signature-navy/50 backdrop-blur-2xl border border-white/10 rounded-[24px] shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden relative group pause-on-hover animate-float transition-all duration-700 hover:scale-[1.01] hover:bg-signature-navy/60",children:[(0,t.jsx)("div",{className:"absolute inset-0 bg-gradient-to-r from-transparent via-white/[0.03] to-transparent pointer-events-none"}),(0,t.jsx)("div",{className:"absolute inset-0 ticker-mask pointer-events-none z-10"}),(0,t.jsx)("div",{className:"h-full flex items-center animate-marquee whitespace-nowrap",children:e.map((e,a)=>(0,t.jsxs)("div",{className:"inline-flex items-center px-12",children:[(0,t.jsx)("span",{className:"text-signature-gold mx-8 text-[8px] select-none opacity-40 group-hover:opacity-80 transition-opacity",children:"✦"}),"ann